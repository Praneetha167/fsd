<!DOCTYPE html>
<html ng-app="jobApp">
<head>
  <meta charset="UTF-8">
  <title>Job Registration Form</title>
  <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.3/angular.min.js"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f0f2f5;
    }
    form {
      max-width: 400px;
      margin: 50px auto;
      padding: 20px;
      background-color: #fff;
      border-radius: 8px;
      border: 1px solid #ccc;
    }
    label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
    }
    input, select {
      width: 100%;
      padding: 8px;
      margin-bottom: 15px;
      border: 2px solid #ccc;
      border-radius: 4px;
      font-size: 14px;
    }
    .valid { border-color: green; }
    .invalid { border-color: red; }
    button {
      width: 100%;
      padding: 10px;
      font-size: 16px;
      color: #fff;
      background-color: #007bff;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    button:hover { background-color: #0056b3; }
    p { font-weight: bold; margin-top: 10px; }
  </style>
</head>
<body ng-controller="JobController">

  <form name="jobForm">
    <label>Full Name:</label>
    <input type="text" name="name" ng-model="job.name"
           ng-class="{'valid': jobForm.name.$valid, 'invalid': jobForm.name.$invalid}"
           required>

    <label>Email:</label>
    <input type="email" name="email" ng-model="job.email"
           ng-class="{'valid': jobForm.email.$valid, 'invalid': jobForm.email.$invalid}"
           required>

    <label>Position Applied:</label>
    <input type="text" name="position" ng-model="job.position"
           ng-class="{'valid': jobForm.position.$valid, 'invalid': jobForm.position.$invalid}"
           required>

    <label>Experience (Years):</label>
    <input type="number" name="experience" ng-model="job.experience"
           ng-class="{'valid': jobForm.experience.$valid, 'invalid': jobForm.experience.$invalid}"
           min="0" required>

    <button type="button" ng-click="submitJob()">Submit</button>
  </form>

  <p ng-if="message">{{message}}</p>

  <script>
    angular.module('jobApp', [])
      .controller('JobController', ['$scope', function($scope) {
        $scope.job = {};
        $scope.message = '';
        $scope.submitJob = function() {
          if ($scope.jobForm.$valid) {
            $scope.message = "Job registration submitted successfully!";
          } else {
            $scope.message = "Please fill all fields correctly.";
          }
        };
      }]);
  </script>

</body>
</html>
