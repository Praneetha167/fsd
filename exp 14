Store.js
import React from "react";

const musicList = [
  { id: 1, name: "Song A", artist: "Artist 1" },
  { id: 2, name: "Song B", artist: "Artist 2" },
  { id: 3, name: "Song C", artist: "Artist 3" },
];

function Store() {
  return (
    <div style={{ textAlign: "center" }}>
      <h1>Music Store</h1>
      <ul>
        {musicList.map((music) => (
          <li key={music.id}>
            {music.name} - {music.artist}
          </li>
        ))}
      </ul>
    </div>
  );
}

export default Store;

