//App.js in src

import React, { useState } from "react";

export default function App() {
  const [balance, setBalance] = useState({
    casual: 10,
    medical: 8
  });

  const [type, setType] = useState("casual");
  const [days, setDays] = useState(1);
  const [history, setHistory] = useState([]);

  const applyLeave = () => {
    if (days <= 0) return;

    if (balance[type] >= days) {
      setBalance({
        ...balance,
        [type]: balance[type] - days
      });

      setHistory([
        ...history,
        { type, days }
      ]);
    } else {
      alert("Not enough leave balance!");
    }
  };

  return (
    <div style={{ textAlign: "center", padding: "20px" }}>
      <h1>Leave Management System</h1>

      <h2>Available Leaves</h2>
      <p>Casual: {balance.casual} days</p>
      <p>Medical: {balance.medical} days</p>

      <h2>Apply Leave</h2>
      <select onChange={(e) => setType(e.target.value)}>
        <option value="casual">Casual Leave</option>
        <option value="medical">Medical Leave</option>
      </select>

      <input
        type="number"
        value={days}
        min="1"
        onChange={(e) => setDays(Number(e.target.value))}
      />

      <button onClick={applyLeave}>Apply</button>

      <h2>Leave History</h2>
      {history.map((h, i) => (
        <p key={i}>
          {h.type} leave - {h.days} days
        </p>
      ))}
    </div>
  );
}
