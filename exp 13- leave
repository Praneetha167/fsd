import React, { useState } from "react";

function App() {
  const [leaves, setLeaves] = useState({
    casual: 10,
    medical: 8,
  });

  const applyLeave = (type) => {
    if (leaves[type] > 0) {
      setLeaves({
        ...leaves,
        [type]: leaves[type] - 1,
      });
    } else {
      alert("No leaves left!");
    }
  };

  return (
    <div style={{ textAlign: "center", marginTop: "50px" }}>
      <h1>Leave Management System</h1>

      <div>
        <h2>Casual Leave: {leaves.casual}</h2>
        <button onClick={() => applyLeave("casual")}>
          Apply Casual Leave
        </button>
      </div>

      <div style={{ marginTop: "20px" }}>
        <h2>Medical Leave: {leaves.medical}</h2>
        <button onClick={() => applyLeave("medical")}>
          Apply Medical Leave
        </button>
      </div>
    </div>
  );
}

export default App;

